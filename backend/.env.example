# Hosted OpenAI-compatible provider (recommended for this small web service).
# Choose a model available to your account. Do not put these credentials in VITE_*.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=45

# Optional dedicated Hugging Face text-generation endpoint, if you have one.
# The existence of a public model card does not imply hosted inference availability.
HF_INFERENCE_URL=
HF_TOKEN=
MODEL_NAME=baidu/ERNIE-4.5-VL-28B-A3B-Thinking

# Optional complete, compatible local checkpoint; no model downloads on API startup.
MODEL_LOCAL_PATH=
CORS_ORIGINS=http://localhost:5173
